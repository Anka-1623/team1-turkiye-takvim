# Copy this file to .env.local and fill in the values. .env.local (and every
# other .env* file except this one) is gitignored — never commit real keys.

# Supabase project → Settings → API. The anon/publishable key is designed to
# be public (it ships in the browser bundle); every table it can touch is
# locked down with RLS + SECURITY DEFINER RPCs, see supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Settings → API → service_role key. Server-only, never
# NEXT_PUBLIC_ — bypasses RLS. Used only by the cron route to look up
# auth.users emails for opted-in members and to send the 7/3/0-day
# reminders. Until this is set, that part of the cron run is skipped
# (everything else still works: dashboard, login, register/manage).
SUPABASE_SERVICE_ROLE_KEY=

# Any random string. Set the same value as a Vercel project env var — Vercel
# then auto-sends it as a Bearer token when it triggers the cron job, and
# the route rejects any request that doesn't match.
CRON_SECRET=

# https://resend.com → API Keys (permission: "Sending access", restricted to
# your verified domain). Until this is set, the daily digest route still runs
# (so cron pings don't fail) but skips sending mail.
RESEND_API_KEY=

# Must be an address on a domain you've verified in Resend (Domains) — Resend
# rejects sends from unverified domains. MAIL_FROM_NAME is cosmetic and
# defaults to "Team1 Türkiye" if unset.
MAIL_FROM_EMAIL=team1turkiye@edutask.app
MAIL_FROM_NAME=Team1 Türkiye

# Comma-separated list of addresses that receive the daily birthday digest.
ADMIN_NOTIFY_EMAILS=

# Optional. Canonical origin used for links/images in cron e-mails. When
# empty, Vercel's production domain is used (or localhost in development).
# Login e-mails always link back to the origin the request came from.
NEXT_PUBLIC_SITE_URL=

# Comma-separated e-mails allowed to open /yonetim: the member list with full
# birth dates and account e-mails, meant for the Team1 Türkiye local lead. The
# person logs in with the same magic link as everyone else; any other account
# gets a 404. Needs SUPABASE_SERVICE_ROLE_KEY above. Treat as private.
LEAD_EMAILS=
