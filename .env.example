# Copy this file to .env.local and fill in the values. .env.local (and every
# other .env* file except this one) is gitignored — never commit real keys.

# Supabase project → Settings → API. The anon/publishable key is designed to
# be public (it ships in the browser bundle); every table it can touch is
# locked down with RLS + SECURITY DEFINER RPCs, see supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Settings → API → service_role key. Server-only, never
# NEXT_PUBLIC_ — bypasses RLS. Used only by the cron route to look up
# auth.users emails for opted-in members and to send the 15/5/3/0-day
# reminders. Until this is set, that part of the cron run is skipped
# (everything else still works: dashboard, login, register/manage).
SUPABASE_SERVICE_ROLE_KEY=

# Any random string. Set the same value as a Vercel project env var — Vercel
# then auto-sends it as a Bearer token when it triggers the cron job, and
# the route rejects any request that doesn't match.
CRON_SECRET=

# https://brevo.com API key (free tier: 300 emails/day, no card needed).
# Until this is set, the daily digest route still runs (so cron pings
# don't fail) but skips sending mail.
BREVO_API_KEY=

# Must be a sender you've verified in Brevo (Settings → Senders) — Brevo
# rejects sends from unverified addresses. MAIL_FROM_NAME is cosmetic and
# defaults to "Team1 Türkiye" if unset.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Team1 Türkiye

# Comma-separated list of addresses that receive the daily birthday digest.
ADMIN_NOTIFY_EMAILS=
